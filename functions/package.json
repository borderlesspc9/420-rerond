{
  "name": "rerond-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "copy-assets": "node -e \"require('fs').cpSync('src/config','lib/config',{recursive:true})\"",
    "build": "tsc && npm run copy-assets",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "npm run build && firebase deploy --only functions"
  },
  "dependencies": {
    "firebase-admin": "^13.9.0",
    "firebase-functions": "^6.3.2",
    "openai": "^6.37.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
