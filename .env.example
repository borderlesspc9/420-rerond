# Copie para `.env` na raiz e ajuste para seu ambiente.

PORT=3001
PUBLIC_BASE_URL=http://localhost:3001

# Frontend (Vite) — opcional; sem isso o solicitacaoService usa http://localhost:3001/api
VITE_API_BASE_URL=http://localhost:3001/api

# Firebase web (Vite / cliente)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=rerond-c747b.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=rerond-c747b
VITE_FIREBASE_STORAGE_BUCKET=rerond-c747b.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Analytics no frontend: desligado em dev por padrão. Use true para forçar no localhost.
# VITE_ENABLE_FIREBASE_ANALYTICS=false

# Firebase Admin (scripts locais / Cloud Functions)
FIREBASE_PROJECT_ID=rerond-c747b
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# Backend Firebase (legado Express) — escolha UM formato:
# Opção 1: credenciais por variáveis separadas (recomendado para CI/CD)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Opção 2: JSON completo da service account em uma única variável
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}'

# Opcional: customizar o nome da coleção no Firestore
VITE_FIRESTORE_SOLICITACOES_COLLECTION=solicitacoes
FIRESTORE_SOLICITACOES_COLLECTION=solicitacoes

# IA (pelo menos uma, conforme o provider em uso)
# OPENAI_API_KEY=
# GROQ_API_KEY=

# Cloud Functions (produção): a chave da OpenAI NÃO fica no .env do repo.
# Configure o secret no projeto Firebase (uma vez por ambiente):
#   npx -y firebase-tools@latest use --add SEU_PROJECT_ID
#   printf '%s' 'SUA_CHAVE_OPENAI' | npx -y firebase-tools@latest functions:secrets:set OPENAI_API_KEY --data-file=-
#   npm run firebase:deploy:functions
# Emulador local: crie functions/.secret.local (não commitar) com uma linha:
#   OPENAI_API_KEY=SUA_CHAVE_OPENAI
